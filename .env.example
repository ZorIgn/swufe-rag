# Local data mode. Leave SWUFE_RELEASE_ROOT empty to use this explicit database.
SWUFE_ACADEMIC_DATABASE=data/academic.sqlite3
SWUFE_RELEASE_ROOT=

# Retrieval. Hybrid mode requires a matching artifact and digest-matching local snapshots.
SWUFE_RETRIEVAL_MODE=hybrid
SWUFE_RETRIEVAL_ARTIFACT_ROOT=artifacts/retrieval
SWUFE_RERANKER_MIN_SCORE=0.5
SWUFE_EMBEDDING_MODEL=/models/embedding
SWUFE_RERANKER_MODEL=/models/reranker

# Promoted release verification. Production requires both values.
SWUFE_RELEASE_ATTESTATION_PUBLIC_KEY=
SWUFE_RELEASE_ATTESTATION_ISSUER=
# Local diagnostics may explicitly load an unattested active pointer. Production rejects it.
SWUFE_ALLOW_UNATTESTED_ACTIVE=false

# HTTP deployment policy.
SWUFE_DEPLOYMENT_MODE=local
SWUFE_HOST=127.0.0.1
SWUFE_PORT=8000
SWUFE_REQUIRE_AUTHENTICATION=false
SWUFE_STATIC_BEARER_TOKEN=
SWUFE_STATIC_BEARER_PRINCIPAL=demo-operator
SWUFE_STATIC_BEARER_ROLES=
SWUFE_TRUSTED_PROXY_CIDRS=
SWUFE_ENABLE_DEBUG_RESPONSES=false
SWUFE_ALLOW_ANONYMOUS_SESSIONS=false
SWUFE_CORS_ALLOW_ORIGINS=http://localhost:3000
SWUFE_REQUEST_MAX_BYTES=32768
SWUFE_RATE_LIMIT_PER_MINUTE=60
SWUFE_RATE_LIMIT_MAX_KEYS=10000
SWUFE_RATE_LIMIT_KEY_MAX_CHARS=256
SWUFE_MAX_CONCURRENT_REQUESTS=32
SWUFE_REQUEST_QUEUE_TIMEOUT_SECONDS=0.25

# Bounded session state. Redis is opt-in and fails closed when configured but unavailable.
SWUFE_SESSION_BACKEND=memory
SWUFE_SESSION_TTL_SECONDS=1800
SWUFE_SESSION_MAX_MESSAGES=12
SWUFE_SESSION_MAX_COUNT=10000
SWUFE_SESSION_MAX_BYTES=16384
SWUFE_REDIS_URL=
SWUFE_REDIS_SESSION_NAMESPACE=swufe-rag:sessions
SWUFE_REDIS_TIMEOUT_SECONDS=1.0

# Request-scoped BYOK provider. No external call occurs without endpoint and model.
SWUFE_LLM_BASE_URL=
SWUFE_LLM_MODEL=
SWUFE_LLM_TIMEOUT_SECONDS=45
SWUFE_LLM_MAX_RETRIES=2
SWUFE_LLM_MAX_TOKENS=1200

# Optional URL for scripts.download_dataset. The command also requires HTTPS,
# an explicit host allow-list and an expected archive SHA-256.
# SWUFE_DATASET_URL=https://example.invalid/swufe-rag-dataset.zip
# SWUFE_DATASET_ALLOWED_HOSTS=example.invalid
# SWUFE_DATASET_SHA256=<expected-archive-sha256>
