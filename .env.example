# Request-scoped provider credentials are sent only in X-LLM-API-Key headers.
# Never put a user API key in this file.
SWUFE_ACADEMIC_DATABASE=data/academic.sqlite3
SWUFE_CORS_ALLOW_ORIGINS=http://localhost:3000
SWUFE_REQUEST_MAX_BYTES=32768
SWUFE_RATE_LIMIT_PER_MINUTE=60
# Set these explicitly to enable request-scoped BYOK calls. Without a configured
# endpoint, an API key alone never causes the service to send data externally.
SWUFE_LLM_BASE_URL=
SWUFE_LLM_MODEL=
# Optional URL used by `python -m scripts.download_dataset`.
# SWUFE_DATASET_URL=https://example.invalid/swufe-rag-dataset.zip
